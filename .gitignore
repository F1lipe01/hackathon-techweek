# Secrets: never commit
.env
.env.*
!.env.example
secrets/

# MCP client configs carry the API key in plain text. Templates are in mcp/
.mcp.json
.vscode/mcp.json
# OAuth tokens saved by our MCP client
mcp/client/.tokens.json

# OS and editors
.DS_Store
Thumbs.db
.idea/
*.swp

# Office lock files
~$*

# Common build and dependency folders
node_modules/
__pycache__/
*.pyc
.venv/
.venv-*/
venv/
dist/
build/

# Local design-check screenshots (tasteskill inspector)
.taste-skill/

# Prototype: local env and runtime data (camera crops, memory)
prototype/.venv/
prototype/data/
prototype/.venv-vision/
prototype/.venv-llm/
prototype/.venv-vlm/
# Face models (ONNX weights from opencv_zoo): fetched once, see AGENTS.md
prototype/models/
*.onnx
*.safetensors
*.gguf
deliverables/executive-summary/.fonts/
prototype/web/docs/

# Videos, recordings and audio stay local (AGENTS.md rule 6); the short logo animations are the exception
video/out/
*.mp4
*.mov
*.m4v
*.webm
*.mkv
*.wav
*.mp3
*.m4a
!assets/brand/animation/out/*.mp4

# Deck build: the JPEG copies build_pptx.py makes of each photo
deliverables/deck/_jpeg/
# A lab frame in which a person who did not agree to appear is not fully blurred (AGENTS.md rule 6)
deliverables/deck/assets/frame-filipe-ia.png
