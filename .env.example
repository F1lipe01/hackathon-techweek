# Copy to .env (gitignored) and fill in.
# The real values were sent to the team lead by Rui Mendes on Slack on 2026-11-16.

# --- Connected Home MCP server (public values from the MCP guide) ---
CONNECTED_HOME_MCP_URL=https://cognitive-home.futurelabsinnovations.com
CONNECTED_HOME_OAUTH_CLIENT_ID=mcp-client
CONNECTED_HOME_OAUTH_REDIRECT_HOST=mcp-redirect.futurelabsinnovations.com
CONNECTED_HOME_OAUTH_CALLBACK_PORT=5434

# API key for the X-API-Key header, supplied by the organisers
CONNECTED_HOME_API_KEY=

# Team account, used in the login step of the MCP OAuth flow
CONNECTED_HOME_USERNAME=
CONNECTED_HOME_PASSWORD=

# Camera feed. RTSP with no authentication: the URL itself is the secret
CAMERA_RTSP_URL=rtsp://go2rtc.futurelabsinnovations.com:8554/<camera-id>

# Wi-Fi network the kit devices were provisioned on (same for every team)
KIT_WIFI_SSID=
KIT_WIFI_PASSWORD=

# Firebase App Distribution invite for the mobile app
APP_INVITE_URL=
